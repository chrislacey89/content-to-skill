---
import Layout from "../layouts/Layout.astro";
import Design18 from "../components/designs/Design18.astro";
import { homepageSchema, site } from "../lib/content";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const ogImageURL = new URL(`${base}og-image.png`, Astro.site);

const jsonLd = homepageSchema(canonicalURL.href, ogImageURL.href);
---

<Layout title={site.title} description={site.description} jsonLd={jsonLd}>
	<Design18 />
</Layout>
